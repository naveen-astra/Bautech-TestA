# Bautech Sentinel - environment template.
#
# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real value here.
#
#     cp .env.example .env
#
# run.py loads .env automatically if it is present. Anything already exported
# in your shell wins over the file, so you can override a single variable for
# one run without editing anything.

# ---------------------------------------------------------------------------
# Plan compiler
#
# Needed only when a case has no cached plan under .plan_cache/. A re-run of an
# unchanged suite makes zero LLM calls and does not need this set.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Persona credentials - see config/personas.yaml
#
# Phone numbers in E.164 without the country code, which personas.yaml supplies
# (+91). The OTP values apply when otp_mode is `fixed`: register each number in
# Firebase Auth as a test number with a fixed verification code, and use that
# code here. No SMS is sent and no reCAPTCHA appears.
# ---------------------------------------------------------------------------
BAUTECH_OWNER_PHONE=
BAUTECH_OWNER_OTP=

BAUTECH_ADMIN_PHONE=
BAUTECH_ADMIN_OTP=

BAUTECH_ENGINEER_PHONE=
BAUTECH_ENGINEER_OTP=

# Only when otp_mode is `relay`. The device has to be able to reach this: on
# BrowserStack that means a public URL or a BrowserStack Local tunnel, never
# localhost.
SENTINEL_OTP_RELAY_URL=

# ---------------------------------------------------------------------------
# BrowserStack - only for `--backend browserstack`
# ---------------------------------------------------------------------------
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Escape hatch: run with an unverified screen map. Leave empty in any run whose
# verdicts you intend to believe - unverified targets are how a suite starts
# manufacturing green results.
# ---------------------------------------------------------------------------
SENTINEL_ALLOW_UNVERIFIED=
